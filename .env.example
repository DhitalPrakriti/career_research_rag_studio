# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Generation (pick one; checked in this order)
# ---------------------------------------------------------------------------

# 1. Gemini — the default path. Direct call to the Gemini API.
GEMINI_API_KEY=
# Defaults to gemini-3.6-flash. Use gemini-3.5-flash-lite for cheap bulk work
# such as RAGAS judging.
GEMINI_MODEL=gemini-3.6-flash

# 2. OpenAI-compatible. Also how you route through a LiteLLM proxy: point
#    OPENAI_BASE_URL at the proxy and use its model alias. Going through the
#    proxy keeps that project's per-model budget caps and Redis caching, which
#    calling Gemini directly does not.
# OPENAI_API_KEY=
# OPENAI_MODEL=gemini-flash
# OPENAI_BASE_URL=http://localhost:4000

# 3. Ollama — fully local, needs `ollama serve` running.
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT=120
# OLLAMA_NUM_GPU=
# OLLAMA_NUM_THREAD=
# OLLAMA_NUM_PREDICT=

# With none of the above set, answers fall back to extractive text — useful for
# running the pipeline with zero keys, but it is NOT real generation, so do not
# score those runs with RAGAS faithfulness or answer relevancy.

# ---------------------------------------------------------------------------
# Retrieval and chunking (all optional; defaults live in config.py)
# ---------------------------------------------------------------------------
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# CHUNK_SIZE=260
# CHUNK_OVERLAP=60
# PARENT_CHUNK_SIZE=520
# PARENT_CHUNK_OVERLAP=100
# CHILD_CHUNK_SIZE=160
# CHILD_CHUNK_OVERLAP=40
# MAX_CONTEXT_CHARS=6000
# TOP_K=5

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=career-research-rag-studio
