# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Which LLM to use: gemini | litellm | openai | ollama | extractive
# Leave unset to auto-detect from whichever credentials are present.
# Always set it explicitly in a deployment.
LLM_PROVIDER=litellm

# --- litellm: your proxy. Keeps its budget caps and response cache. ---
LITELLM_API_KEY=
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL=gemini-flash

# --- gemini: direct API call. No budget cap in front of it. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- openai or any other OpenAI-compatible endpoint ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# --- ollama: fully local, needs `ollama serve` ---
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# With no provider configured, answers fall back to extractive text. Useful for
# running retrieval with zero keys, but it is not generation — never score those
# runs for faithfulness or answer relevancy.

# How the agent picks a retrieval strategy: auto | llm | rules
# auto uses the LLM when a provider is configured, otherwise the deterministic rules.
# rules costs one fewer LLM call per query and keeps routing reproducible.
# ROUTER_MODE=auto

# --- optional: LangSmith tracing ---
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=career-research-rag-studio

# Runtime document management: uploads and deletes are allowed by default.
# Set to false for any publicly reachable deployment - these endpoints have no auth.
# ALLOW_DOCUMENT_WRITES=true
